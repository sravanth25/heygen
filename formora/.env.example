# FORMORA environment example. Copy to .env.local (or run `npm run setup:preview`).
# Never commit real secrets.

# --- Mode -------------------------------------------------------------------
# preview: demo prices + simulated checkout, nothing indexed.
# live:    real checkout, ONLY takes effect when every launch blocker is resolved.
FORMORA_MODE=preview
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated product IDs to mark unavailable without a code change.
# e.g. FORMORA_UNAVAILABLE_PRODUCTS=hydration-peach-mango
FORMORA_UNAVAILABLE_PRODUCTS=

# --- Payments ---------------------------------------------------------------
# demo | stripe  (stripe requires sk_test_ keys in preview mode)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signs events from the demo payment simulator.
DEMO_WEBHOOK_SECRET=

# --- Admin ------------------------------------------------------------------
ADMIN_EMAIL=
# Generate with: npm run hash-password -- "a long unique password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Storage ----------------------------------------------------------------
# Directory for the preview JSON store (orders, outbox). Defaults to ./.data
DATA_DIR=
# Seed clearly-labelled synthetic orders into the admin prototype (preview only).
SEED_SYNTHETIC_ORDERS=1

# --- Analytics --------------------------------------------------------------
# none | console. Any provider other than "none" shows a consent prompt first.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
ANALYTICS_SERVER_LOG=0
